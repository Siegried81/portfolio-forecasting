# Copy to .env and fill in your own keys. Never commit .env (see .gitignore).
# Every var below is read directly in src/config.py — kept in sync with that
# file and with render.yaml on purpose, so local dev and prod never diverge
# silently. If you add a new os.getenv(...) in config.py, add it here too.

# --- LLM (Groq primary, up to 5 keys for free-tier rate-limit rotation) ---
# Only GROQ_API_KEY is required; _2.._5 are optional extras.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# Leave unset to use config.py's own default (openai/gpt-oss-120b) — only
# override if you deliberately want a different model than the code default.
# GROQ_MODEL=

# --- LLM hosted fallbacks (used automatically if Groq fails; tried in this order) ---
# OpenRouter, Cerebras, and SambaNova are all hosted (unlike Ollama below), so these
# are the fallbacks that actually work once deployed (Render/Streamlit Cloud have no
# local Ollama daemon) — not just repeated copies of the same idea as Groq. Cerebras
# and SambaNova are, like Groq, dedicated fast-inference hardware providers — genuine
# redundancy against each other, not a random pick. All optional and independent: set
# as many or as few as you like, in any combination — llm_client.py only tries
# whichever ones actually have a key configured, skipping the rest entirely.
OPENROUTER_API_KEY=
# Leave unset to use config.py's own default (openai/gpt-oss-120b:free).
# OPENROUTER_MODEL=
CEREBRAS_API_KEY=
# Leave unset to use config.py's own default (llama-3.3-70b).
# CEREBRAS_MODEL=
SAMBANOVA_API_KEY=
# Leave unset to use config.py's own default (Meta-Llama-3.3-70B-Instruct).
# SAMBANOVA_MODEL=

# --- LLM fallback, local-dev only (used if Groq AND every hosted fallback above fail) ---
# Only reachable if you're actually running an Ollama daemon on this machine
# — silently unreachable in a deployed container, which is exactly why the
# hosted fallbacks above exist as the tiers that work in production too.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News & filings (AI Analyst tab) ---
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- Macro context (live risk-free rate, 10Y-3M term spread) ---
FRED_API_KEY=

# --- Market data fallback (only used if Yahoo Finance is unreachable) ---
TWELVEDATA_API_KEY=
# Third tier, tried first among the three (before Twelve Data/Alpha Vantage) —
# free tier is 500 req/hour, the most generous of the three.
TIINGO_API_KEY=
# Fourth, last-resort tier — only tried if Twelve Data ALSO fails. Free tier
# is 25 requests/DAY (the stingiest of the three), which is why it sits last.
ALPHA_VANTAGE_API_KEY=

# --- Academic literature grounding for the chatbot (src/academic_search.py) ---
# UNLIKE every key above, this one is genuinely optional even at the API level —
# Semantic Scholar's search endpoint works fully unauthenticated (a lower shared
# rate limit, not a hard requirement). A key just raises that ceiling. Get one
# (optional) at semanticscholar.org/product/api.
SEMANTIC_SCHOLAR_API_KEY=

# --- Optional production cache (src/cache.py) ---
# Leave unset for local/free-tier deployments — every @cached() call falls
# through to Streamlit's own @st.cache_data with no behaviour change. Set
# this only if you're running the optional `redis` service from
# docker-compose.yml (`docker compose --profile with-redis up`) or a real
# managed Redis instance.
# REDIS_URL=redis://redis:6379/0
