# Copy to .env and fill in your own keys. Never commit .env (see .gitignore).
# Kept in sync with src/config.py and render.yaml — add new vars to both.

# --- LLM (Groq primary, up to 5 keys for free-tier rate-limit rotation) ---
# Only GROQ_API_KEY is required; _2.._5 are optional extras.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Leave unset to use config.py's default (openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# --- LLM hosted fallbacks (tried in this order if Groq fails) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# --- LLM fallback, local-dev only (tried if Groq and every hosted fallback fail) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News & filings (AI Analyst tab) ---
NEWSAPI_KEY=
FINNHUB_API_KEY=

# --- Macro context (live risk-free rate, 10Y-3M term spread) ---
FRED_API_KEY=

# --- Market data fallback (only used if Yahoo Finance is unreachable) ---
TWELVEDATA_API_KEY=
# Tried first among the fallbacks — 500 req/hour free tier.
TIINGO_API_KEY=
# Last resort — 25 requests/day free tier.
ALPHA_VANTAGE_API_KEY=

# --- Academic literature grounding (src/academic_search.py) ---
# Optional even without a key (works unauthenticated at a lower rate limit).
SEMANTIC_SCHOLAR_API_KEY=

# --- Optional production cache (src/cache.py) ---
# Leave unset for local/free-tier deployments. Set only if running the
# optional `redis` service from docker-compose.yml or a managed Redis instance.
# REDIS_URL=redis://redis:6379/0
